begin
    int x=0;
    int y=(x+1)*2;
    bool a=y>=2;
    // In gia tri boolean
    if (a) then {
        print(y);
    } else {
        x=x+1;
    }
    /* Vong lap thuc hien it nhat mot lan */
    do {
        x=x+1;
    } while (3>x);
    for (int i=0; 3>i; i=i+1) {
        print(i);
    }
    print(a==true);
end
